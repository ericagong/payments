# ====== Husky pre-commit Hook ======
# 커밋 전: 변경 파일 대상 typecheck + lint(eslint + stylelint) + format(prettier)


echo "🔍 Running Typescript typecheck"
pnpm typecheck || {
  echo "❌ Typecheck failed. Commit aborted."
  exit 1
}
echo "✅ typecheck passed!"


echo "🔍 Running lint-staged(eslint + stylelint + prettier)"
pnpm lint-staged || {
  echo "❌ Lint-staged failed. Commit aborted."
  exit 1
}
echo "✅ lint-staged passed!"
