    "stylelint": "stylelint 'src/**/*.{css,scss}' --fix --cache --cache-location .stylelintcache",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,css,scss,md,json,yml,yaml}'",
    "fix:all": "pnpm eslint && pnpm stylelint && pnpm format"
  },
  "devDependencies": {
